{
  "name": "astrolab",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Astrolabe: a local-first study hub where your own coding agent (Claude Code, Codex CLI, Gemini CLI) is the mentor and the examiner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/criocore/astrolab.git"
  },
  "homepage": "https://github.com/criocore/astrolab#readme",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "build:pack": "tsx tools/build-pack.ts",
    "check:pack": "tsx tools/check-pack.ts packs/src/ai-engineer --built packs/ai-engineer.json",
    "test": "node --test --import tsx \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
