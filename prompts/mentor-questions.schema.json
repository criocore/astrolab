{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mentor-questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "covers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[0-9]+$" }
          }
        }
      }
    }
  }
}
